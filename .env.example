# Servidor
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4173

# Proxy inverso (producción detrás de nginx): número de saltos de confianza.
# Dejar vacío si la app se expone directamente, sin proxy.
TRUST_PROXY=
# Límite global de requests por IP cada 15 minutos (por defecto 100)
RATE_LIMIT_GLOBAL_MAX=100

# Superadmin (lo usa el seeder de usuarios; la contraseña NO se guarda en el repo)
SPADM=superadmin@estelaris.com
SPADM_PWD=cambiar_por_una_contraseña_de_12+_caracteres

# Base de datos - Desarrollo
MYSQL_DEV_USER=root
MYSQL_DEV_PASSWORD=your_password
MYSQL_DEV_DB_NAME=estelaris_dev
MYSQL_DEV_HOST=localhost

# Base de datos - Test
MYSQL_TEST_USER=root
MYSQL_TEST_PASSWORD=your_password
MYSQL_TEST_DB_NAME=uat_estelaris
MYSQL_TEST_HOST=localhost
MYSQL_TEST_PORT=3306

# Base de datos - Produccion
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB_NAME=estelaris
MYSQL_HOST=localhost
# Log de consultas SQL en producción (desactivado por defecto)
DB_LOGGING=false

# JWT
# IMPORTANTE: Generar un secret robusto con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Debe ser un string hexadecimal de 128 caracteres mínimo (256 bits)
JWT_SECRET=your_secret_key_here_replace_with_strong_secret_128_chars_minimum

# Logging (opcional)
# Niveles: error | warn | info | debug
# En producción usar 'info' o 'warn', en desarrollo usar 'debug'
LOG_LEVEL=info
